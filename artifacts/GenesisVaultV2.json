ernalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"pay\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"rescueSurplus\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"controller_\",\"type\":\"address\"}],\"name\":\"setController\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bool\",\"name\":\"paused_\",\"type\":\"bool\"}],\"name\":\"setPaused\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"transferOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"rescueSurplus(address,address,uint256)\":{\"details\":\"Rescue intentionally remains available while paused: it is owner-only and      strictly limited to physical surplus above the controller-reported reserved      obligations, so it can never touch funds backing live obligations regardless      of pause state. Pausing gates controller payouts, not this bounded owner path.\"}},\"title\":\"GenesisVaultV2\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"available(address)\":{\"notice\":\"Physical balance of `token` held by the vault.\"},\"pay(address,address,uint256)\":{\"notice\":\"Release `amount` of `token` to `to`. Controller-only, non-reentrant,         blocked while paused. A zero amount is an explicit no-op (still emits).         Reverts on insufficient physical balance or a failed transfer, which         rolls back the controller's withdrawal or the hook's atomic unit.\"},\"rescueSurplus(address,address,uint256)\":{\"notice\":\"Rescue TRUE SURPLUS only: physical balance minus the controller's         on-chain reserved obligations for the token. Reserved custody backing         live obligations can never be withdrawn. Break-glass, owner-only.\"},\"setController(address)\":{\"notice\":\"Bind the sole payer ONCE. Custody authority can never be repointed;         replacing the controller requires a new vault.\"},\"setPaused(bool)\":{\"notice\":\"Pause/unpause outgoing payments. Never affects incoming transfers.\"}},\"notice\":\"Physical custody for the Phase 3C/4 Model A non-trader economics. During atomic hook realization the frozen GenesisHookV5 moves the full distributable D out of itself: the trader share to the PoolManager, and the non-trader share (LP + protocol + router + keeper + dust) to THIS vault, via a plain ERC-20 transfer to this address \\u2014 the hook never calls into the vault. GenesisRewardsController ledgers obligations against the vault and later calls pay() to release them; it reads available() for surplus checks. The vault is a simple custody + payment contract. It holds NO economics, no accounting mirror of controller obligations, no upgradeability, no delegatecall, no ETH custody, no allowlists, no fees. Authority:   owner (Safe): binds the controller once, pauses payouts, transfers ownership,                 and rescues ONLY true surplus (never reserved obligations).   controller  : the sole caller of pay(); bound once, never replaced.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/vault/GenesisVaultV2.sol\":\"GenesisVaultV2\"},\"evmVersion\":\"cancun\",\"libraries\":{\"src/libraries/AmpLib.sol:AmpLib\":\"0x007dd8272788dd705e0bb4746df23806eb8f4f69\",\"src/libraries/GenesisDistLib.sol:GenesisDistLib\":\"0xbfe72deb3902f871a1a46384f5e66c184aceeff7\"},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@ensdomains/=lib/v4-core/node_modules/@ensdomains/\",\