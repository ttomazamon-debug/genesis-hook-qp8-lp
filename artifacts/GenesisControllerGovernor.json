nternalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"next\",\"type\":\"address\"}],\"name\":\"schedule\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"scheduled\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"transferOwner\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"title\":\"GenesisControllerGovernor\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"schedule(address)\":{\"notice\":\"Schedule a controller change. `next == address(0)` is the explicit         unbind path (rewards permanently off until re-bound via a new schedule).\"}},\"notice\":\"The 48-hour timelock for rewards-controller replacement, moved OUT of         GenesisHookV5 (Phase 3B size optimization, Option A). The hook holds `immutable controllerGovernor == address(this)` and accepts setRewardsController() from this contract ONLY. The delay therefore lives here rather than being duplicated in the hook's bytecode. \\u2500\\u2500 SECURITY PROPERTIES PRESERVED FROM THE HOOK-NATIVE TIMELOCK \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500  \\u2022 no instant operator replacement \\u2014 every change waits DELAY  \\u2022 anti-V6: the controller remains replaceable, so a controller bug never    forces a hook redeploy  \\u2022 zero-address unbind is explicit and still timelocked  \\u2022 no generic arbitrary-call logic: this contract can call exactly one    function on exactly one target, both fixed at construction Owner should be the Safe (0xF84D2025cE5fBe87Ff78951383befE5693169e23).\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/gove